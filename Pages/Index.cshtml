@page
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .welcome-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            padding: 60px 40px;
            text-align: center;
            max-width: 500px;
            width: 100%;
        }
        .welcome-container h1 {
            font-size: 48px;
            color: #333;
            font-weight: bold;
            margin-bottom: 20px;
        }
        .welcome-container p {
            font-size: 18px;
            color: #666;
            margin-bottom: 40px;
            line-height: 1.6;
        }
        .btn-login {
            display: inline-block;
            padding: 15px 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 16px;
            transition: 0.3s;
        }
        .btn-login:hover {
            opacity: 0.9;
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
            text-decoration: none;
            color: white;
        }
        .features {
            margin-top: 50px;
            text-align: left;
        }
        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            font-size: 14px;
            color: #666;
        }
        .feature-item::before {
            content: "✓";
            display: inline-block;
            width: 25px;
            height: 25px;
            line-height: 25px;
            background: #28a745;
            color: white;
            border-radius: 50%;
            text-align: center;
            margin-right: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="welcome-container">
        <h1>🏪 Shop Management System</h1>
        <p>A lightweight transaction management system designed for small shops and service centers.</p>

        <a href="@Url.Page("/Login")" class="btn-login">Get Started</a>

        <div class="features">
            <div class="feature-item">Lightweight & Fast</div>
            <div class="feature-item">SQLite Database</div>
            <div class="feature-item">Easy to Use Interface</div>
            <div class="feature-item">Role-Based Access Control</div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
